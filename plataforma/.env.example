# ------------------------------------------------------------------
# Copia este archivo como .env y rellena los valores.
# .env NUNCA se sube a Git (está en .gitignore).
# ------------------------------------------------------------------

# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=catedrahispanidad.es,www.catedrahispanidad.es
DJANGO_CSRF_TRUSTED_ORIGINS=https://catedrahispanidad.es,https://www.catedrahispanidad.es
# Correos que reciben los avisos de error del servidor (separados por comas)
DJANGO_ADMINS=

# URL pública, sin barra final
SITIO_URL=https://catedrahispanidad.es

# Base de datos (en Docker la rellena docker-compose.yml a partir de POSTGRES_*)
POSTGRES_DB=catedra
POSTGRES_USER=catedra
POSTGRES_PASSWORD=
# DATABASE_URL=postgres://catedra:CONTRASEÑA@db:5432/catedra

# Correo saliente (ej. Brevo: smtp-relay.brevo.com, puerto 587)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Cátedra de la Hispanidad <no-responder@catedrahispanidad.es>

# Stripe: claves de prueba (sk_test_…) hasta el lanzamiento, luego las reales (sk_live_…)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Prefijo con el que aparecen las ventas en el panel de Stripe de la empresa
STRIPE_PREFIJO_PRODUCTO=Cátedra

# Analítica Umami (se rellena tras crear el sitio en el panel de Umami)
UMAMI_SCRIPT_URL=https://estadisticas.catedrahispanidad.es/script.js
UMAMI_WEBSITE_ID=
UMAMI_APP_SECRET=
UMAMI_DB_PASSWORD=

# Dominios que Caddy sirve con HTTPS automático
DOMINIO=catedrahispanidad.es
DOMINIO_ESTADISTICAS=estadisticas.catedrahispanidad.es
